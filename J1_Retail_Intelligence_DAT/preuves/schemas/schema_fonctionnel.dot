digraph UC01 {
  rankdir=LR; nodesep=0.15; ranksep=0.6;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#FFFFFF"];
  edge [color="#7F7F7F", arrowsize=0.6];

  subgraph cluster_u { label="Utilisateurs"; fontname="Helvetica-Bold"; color="#BFBFBF";
    DG [label="Direction générale", fillcolor="#DDEBF7"];
    DC [label="Direction commerciale", fillcolor="#DDEBF7"];
    RM [label="Responsable magasin", fillcolor="#DDEBF7"];
    CG [label="Contrôleur de gestion", fillcolor="#DDEBF7"];
    RS [label="Responsable stocks", fillcolor="#DDEBF7"];
    MK [label="Marketing / e-commerce", fillcolor="#DDEBF7"];
  }
  subgraph cluster_q { label="Questions décisionnelles"; fontname="Helvetica-Bold"; color="#BFBFBF";
    Q1 [label="Évolution des ventes\net part par canal"];
    Q2 [label="Produits / catégories\nles plus vendus"];
    Q3 [label="Performance\ndes magasins"];
    Q4 [label="Remises et\nretours"];
    Q5 [label="Niveaux de stock\net ruptures"];
    Q6 [label="Clients, navigation\net avis"];
  }
  subgraph cluster_k { label="Indicateurs (KPI)"; fontname="Helvetica-Bold"; color="#BFBFBF";
    K1 [label="K01 CA net HT\nK08 Part par canal\nK07 Évolution du CA"];
    K2 [label="K02 Transactions\nK03 Panier moyen\nK04 Quantités vendues"];
    K3 [label="K05 Taux de remise\nK06 Taux de retour"];
    K4 [label="K09 Stock moyen\nK10 Taux de rupture"];
    K5 [label="K11 Note moyenne avis\nK12 Clics liés à un achat"];
  }
  subgraph cluster_f { label="Fichiers observés (Vérifié)"; fontname="Helvetica-Bold"; color="#548235";
    node [fillcolor="#E2EFDA"];
    F1 [label="store_sales\nweb_sales"];
    F2 [label="store_returns\nweb_returns"];
    F3 [label="item · store · date_dim\ncustomer · promotion"];
    F4 [label="inventory\nwarehouse"];
    F5 [label="web_clickstreams\nproduct_reviews"];
  }
  subgraph cluster_n { label="Non disponible / à compléter"; fontname="Helvetica-Bold"; color="#C00000";
    node [fillcolor="#FCE4D6", style="rounded,filled,dashed"];
    N1 [label="Libellés des motifs\nde retour (texte aléatoire)"];
    N2 [label="Ajouts au panier,\nsessions web"];
    N3 [label="Devise, objectifs,\ncoûts logistiques"];
  }
  DG -> Q1; DC -> Q1; DC -> Q2; RM -> Q3; CG -> Q4; CG -> Q1; RS -> Q5; MK -> Q6; DC -> Q4;
  Q1 -> K1; Q2 -> K2; Q3 -> K1; Q3 -> K2; Q4 -> K3; Q5 -> K4; Q6 -> K5;
  K1 -> F1; K1 -> F3; K2 -> F1; K3 -> F1; K3 -> F2; K4 -> F4; K5 -> F5;
  Q4 -> N1 [style=dashed, color="#C00000"]; Q6 -> N2 [style=dashed, color="#C00000"]; Q1 -> N3 [style=dashed, color="#C00000"];
}
