digraph AZ {
  rankdir=LR; nodesep=0.18; ranksep=0.9;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9];
  edge [color="#7F7F7F", arrowsize=0.6, style=dashed];
  subgraph cluster_l { label="Local – Linux / Ubuntu (mise en œuvre prévue J2–J3)"; fontname="Helvetica-Bold"; color="#548235";
    node [fillcolor="#E2EFDA"];
    L1 [label="Fichiers .dat (kit TPCx-BB)"];
    L2 [label="Apache NiFi (ingestion)"];
    L3 [label="HDFS /retail/bronze|silver|gold"];
    L4 [label="Spark / PySpark (traitements)"];
    L5 [label="Spark SQL / notebooks"];
    L6 [label="Utilisateurs Linux + permissions HDFS"];
    L7 [label="Fichier .env local (hors Git)"];
  }
  subgraph cluster_a { label="Cible Azure – conception logique (J4, non déployée)"; fontname="Helvetica-Bold"; color="#2F5597";
    node [fillcolor="#DDEBF7"];
    A1 [label="Dépôt dans le conteneur landing"];
    A2 [label="Azure Data Factory (pipelines)"];
    A3 [label="ADLS Gen2 (HNS activé)\nconteneurs bronze | silver | gold"];
    A4 [label="Synapse Spark Pools"];
    A5 [label="Synapse SQL serverless + Studio"];
    A6 [label="Microsoft Entra ID + RBAC + ACL"];
    A7 [label="Azure Key Vault (secrets)"];
  }
  L1 -> A1; L2 -> A2; L3 -> A3; L4 -> A4; L5 -> A5; L6 -> A6; L7 -> A7;
}
