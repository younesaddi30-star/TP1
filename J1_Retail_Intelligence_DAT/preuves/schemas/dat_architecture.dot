digraph ARCHI {
  rankdir=TB; nodesep=0.3; ranksep=0.3;
  labelloc=b; fontname="Helvetica"; fontsize=10;
  label="Gouvernance transverse : manifeste de provenance · catalogue · règles qualité\njournal des traitements · permissions par zone · pseudonymisation · suivi des coûts";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#FFFFFF"];
  edge [color="#595959", arrowsize=0.6, fontname="Helvetica", fontsize=8];

  subgraph cluster_src { label="Sources"; fontname="Helvetica-Bold"; color="#BFBFBF";
    S1 [label="TPCx-BB\ndata/\n23 tables .dat", fillcolor="#E2EFDA"];
    S2 [label="TPCx-BB\ndata_refresh/\n11 tables .dat", fillcolor="#E2EFDA"];
    S3 [label="Sources\ncomplémentaires\n(aucune à ce jour)", fillcolor="#F2F2F2", style="rounded,filled,dashed"];
  }
  I1 [label="Ingestion batch\nApache NiFi\n(repli : script\nPython + hdfs)", fillcolor="#DDEBF7"];
  subgraph cluster_lake { label="Data Lake – HDFS (local) / ADLS Gen2 (cloud)"; fontname="Helvetica-Bold"; color="#2F5597";
    B [label="BRONZE\n.dat tels que reçus\nimmuables\n+ manifeste", fillcolor="#F8CBAD"];
    P1 [label="Python /\nPySpark\ntypage\ncontrôles", shape=box, style="filled", fillcolor="#DDEBF7", fontsize=9];
    SV [label="SILVER\nParquet typé\ncontrôlé\npseudonymisé", fillcolor="#D9D9D9"];
    P2 [label="PySpark\njointures\nagrégats", shape=box, style="filled", fillcolor="#DDEBF7", fontsize=9];
    G [label="GOLD\nétoile Parquet\nfaits + dims\n+ agrégats KPI", fillcolor="#FFE699"];
    Q [label="QUARANTAINE\nrejets + motif", fillcolor="#FCE4D6", style="rounded,filled,dashed"];
  }
  subgraph cluster_use { label="Usages"; fontname="Helvetica-Bold"; color="#BFBFBF";
    U1 [label="KPI K01–K12", fillcolor="#E2EFDA"];
    U2 [label="Notebooks\nSpark SQL", fillcolor="#E2EFDA"];
    U3 [label="Tableaux de bord\n(outil à valider)", fillcolor="#E2EFDA"];
  }

  S1 -> I1; S2 -> I1; S3 -> I1 [style=dashed];
  I1 -> B; B -> P1 -> SV -> P2 -> G;
  P1 -> Q [style=dashed];
  G -> U1; G -> U2; G -> U3;
}
