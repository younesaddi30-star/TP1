digraph FLUX {
  rankdir=TB; nodesep=0.3; ranksep=0.45;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, fillcolor="#FFFFFF"];
  edge [color="#595959", arrowsize=0.6, fontname="Helvetica", fontsize=8];
  subgraph cluster_nifi { label="F1 – Ingestion (Apache NiFi, batch, à chaque livraison)"; fontname="Helvetica-Bold"; color="#2F5597";
    N1 [label="ListFile +\nFetchFile\n(*.dat, *.csv)", fillcolor="#DDEBF7"];
    N2 [label="HashContent\n(MD5)", fillcolor="#DDEBF7"];
    N3 [label="UpdateAttribute\ntable, lot,\ndate d'ingestion", fillcolor="#DDEBF7"];
    N4 [label="PutHDFS\n→ bronze/", fillcolor="#DDEBF7"];
    N5 [label="Manifeste\n(fichier, taille,\nMD5, horodatage)", fillcolor="#DDEBF7"];
    {rank=same; N1; N2; N3; N4; N5;}
    N1 -> N2 -> N3 -> N4 -> N5;
  }
  BR [label="BRONZE\n.dat bruts", fillcolor="#F8CBAD"];
  subgraph cluster_s { label="F2 – Bronze → Silver (PySpark, batch)"; fontname="Helvetica-Bold"; color="#2F5597";
    T1 [label="Lecture « | »\n+ schéma explicite\n(noms + types)", fillcolor="#E2EFDA"];
    T2 [label="Contrôles\nstructure · nulls ·\nclés · intégrité", fillcolor="#E2EFDA"];
    T3 [label="Union data +\nrefresh, colonne _lot\npseudonymisation", fillcolor="#E2EFDA"];
    {rank=same; T1; T2; T3;}
    T1 -> T2 -> T3;
  }
  SV [label="SILVER\nParquet\npartitionné", fillcolor="#D9D9D9"];
  QU [label="QUARANTAINE", fillcolor="#FCE4D6", style="rounded,filled,dashed"];
  subgraph cluster_g { label="F3 – Silver → Gold (PySpark, batch)"; fontname="Helvetica-Bold"; color="#2F5597";
    G1 [label="Dimensions\nconformes", fillcolor="#FFF2CC"];
    G2 [label="Faits ventes\nmagasin + web\n(canal), retours,\nstock", fillcolor="#FFF2CC"];
    G3 [label="Agrégats KPI\n(jour × lieu ×\ncatégorie)", fillcolor="#FFF2CC"];
    {rank=same; G1; G2; G3;}
    G1 -> G2 -> G3;
  }
  GO [label="GOLD\nétoile + KPI", fillcolor="#FFE699"];
  CO [label="F4 – Exposition\nnotebooks, SQL,\ntableaux de bord", fillcolor="#E2EFDA"];
  N4 -> BR [lhead=cluster_nifi]; BR -> T1; T3 -> SV; T2 -> QU [style=dashed, label="rejets"]; N2 -> QU [style=dashed, label="échec"];
  SV -> G1; G3 -> GO; GO -> CO;
}
